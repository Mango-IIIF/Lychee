# Copy to the repository root as .env to demo the configurable endpoints with `npm run dev`.
# Without these the demo hides "Suggest with AI" and offers Wikidata only.
ANTHROPIC_API_KEY=
# Free account at https://www.geonames.org/login, then enable "free web services" on your account page
GEONAMES_USERNAME=
# Optional comma-separated allowlist of image hosts the AI endpoint may fetch (empty = any public host)
ALLOWED_IMAGE_HOSTS=iiif.llyfrgell.cymru,damsssl.llgc.org.uk
