{
  "name": "@mango-iiif/annotate",
  "version": "0.1.0",
  "description": "A IIIF annotation editor for Mango, built on @mango-iiif/iiif-viewer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mango-IIIF/annotate.git"
  },
  "homepage": "https://github.com/Mango-IIIF/annotate#readme",
  "bugs": {
    "url": "https://github.com/Mango-IIIF/annotate/issues"
  },
  "keywords": [
    "iiif",
    "annotation",
    "annotation-editor",
    "w3c-web-annotation",
    "svelte",
    "digital-collections"
  ],
  "type": "module",
  "packageManager": "npm@10.9.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "src/dist"
  ],
  "main": "./src/dist/index.js",
  "module": "./src/dist/index.js",
  "types": "./src/dist/index.d.ts",
  "unpkg": "./src/dist/mango-annotation-editor.js",
  "jsdelivr": "./src/dist/mango-annotation-editor.js",
  "exports": {
    ".": {
      "import": "./src/dist/index.js",
      "types": "./src/dist/index.d.ts"
    },
    "./element": {
      "import": "./src/dist/element.js"
    },
    "./style.css": "./src/dist/annotate.css"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-demo.mjs",
    "build:lib": "NODE_OPTIONS=--experimental-global-webcrypto vite build --config vite.config.lib.ts",
    "build:element": "NODE_OPTIONS=--experimental-global-webcrypto vite build --config vite.config.element.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "npm run build:all",
    "sync:demo": "node scripts/sync-demo.mjs",
    "build:demo": "npm run build:dist && npm run sync:demo",
    "build:all": "npm run build:demo",
    "build:dist": "npm run build:lib && npm run build:element && npm run build:types",
    "prepack": "npm run build:dist",
    "lint": "eslint .",
    "i18n:check": "tsx src/locales/check-locales.ts",
    "format": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.25.0",
    "@mango-iiif/annotation": "^1.0.0",
    "@mango-iiif/iiif-viewer": "file:../Mango",
    "@mango-iiif/w3c-parser": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.49.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^24.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^15.14.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.2.8",
    "svelte": "^5.43.8",
    "svelte-eslint-parser": "^1.8.0",
    "tsx": "^4.22.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  }
}
